      "source": [
        "import numpy as np\n",
        "\n",
        "# 1D array\n",
        "vector_a = np.array([[1, 4], [5, 6]])\n",
        "vector_b = np.array([[2, 4], [5, 2]])\n",
        "\n",
        "# Compute dot product of 'vector_a' and 'vector_b'\n",
        "dot_prod = np.dot(vector_a, vector_b)\n",
        "print(\"Dot Product  : \\n\", dot_prod)"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
