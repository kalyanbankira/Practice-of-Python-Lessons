        "# Import libraries\n",
        "import pandas as pd\n",
        "\n",
        "# Make a DataFrame\n",
        "df = pd.DataFrame({'A': [0, 1, 2, 9, 4],\n",
        "                   'B': [4, 9, 2, 0, 3],\n",
        "                   'C': [8, 2, 7, 6, 8]})\n",
        "\n",
        "# Perform the rolling window calculations with window size = 2\n",
        "df.rolling(2).sum()"
